# Backend API URL
# Local development
NEXT_PUBLIC_API_URL=http://localhost:8000

# Production deployment
# NEXT_PUBLIC_API_URL=https://api.doc2skill.com

# Python settings
PYTHONUNBUFFERED=1

# Node environment
NODE_ENV=production

# Anthropic API Configuration (for AI enhancement)
# Get your API key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=your-api-key-here
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_TIMEOUT_MS=3000000

# Production Setup:
# Frontend: https://doc2skill.com
# Backend:  https://api.doc2skill.com
#
# Environment Variables for Dokploy:
# NEXT_PUBLIC_API_URL=https://api.doc2skill.com
# ANTHROPIC_API_KEY=sk-ant-your-actual-key-here
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# ANTHROPIC_TIMEOUT_MS=3000000
